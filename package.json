		"react-dom": "^19.2.7",
		"zod": "4"
	},
	"devDependencies": {
		"@edge-runtime/vm": "^5.0.0",
		"@feature-sliced/steiger-plugin": "^0.7.0",
		"@inlang/paraglide-js": "^2.20.2",
