{
	"name": "reatom-convex-auth",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"module": "index.ts",
	"imports": {
		"#.storybook/*": "./.storybook/*",
		"#convex/*": "./convex/*",
		"#styled-system/*": "./src/shared/styled-system/*",
		"#theme/*": "./theme/*",
		"#*": "./src/*"
	},
	"scripts": {
		"build": "mise run build:webapp",
		"dev": "mise run dev",
		"fix": "mise run fix",
		"format": "mise run format",
